parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: reports/phpstan
    ignoreErrors:
        # bcmath operates on numeric strings, which the native string type and the strpos cast do not express.
        - identifier: argument.type
          path: src/Internal/BaseConverter.php
        # Data provider return shapes carry no value type, and tests take no descriptive PHPDoc.
        - identifier: missingType.iterableValue
          path: tests/Base62Test.php
        # hex2bin returns string or false, narrowed to a valid string by the fixed hexadecimal fixtures.
        - identifier: argument.type
          path: tests/Base62Test.php
    reportUnmatchedIgnoredErrors: true
